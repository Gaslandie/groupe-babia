Options -Indexes
DirectoryIndex index.php index.html

<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|.*\.sql|.*\.log)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Protocole. Sur un hebergement mutualise, le SSL est souvent termine par un
  # proxy en amont : %{HTTPS} vaut alors "off" meme sur une requete HTTPS, ce qui
  # produit une boucle de redirection infinie. On teste donc aussi l'en-tete
  # transmise par le proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.groupebabia.com%{REQUEST_URI} [R=301,L,NE]

  # Domaine canonique : apex et alias vers www, en une seule redirection.
  RewriteCond %{HTTP_HOST} !^www\.groupebabia\.com$ [NC]
  RewriteRule ^ https://www.groupebabia.com%{REQUEST_URI} [R=301,L,NE]

  # URLs publiques propres pour les fiches de realisations.
  RewriteRule ^realisations/([A-Za-z0-9-]+)/?$ realisation.php?slug=$1 [L,QSA]

  # Les pages publiques sont maintenant servies par PHP. Les anciennes URLs HTML
  # restent acceptees, mais redirigent vers les points d'entree canoniques.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^groupe\.html$ /groupe.php [R=301,L]
  RewriteRule ^agroalimentaire\.html$ /agroalimentaire.php [R=301,L]
  RewriteRule ^btp\.html$ /btp.php [R=301,L]
  RewriteRule ^mines\.html$ /mines.php [R=301,L]
  RewriteRule ^catalogue\.html$ /catalogue.php [R=301,L]
  RewriteRule ^contact\.html$ /contact.php [R=301,L]
  RewriteRule ^mentions-legales\.html$ /mentions-legales.php [R=301,L]
  RewriteRule ^confidentialite\.html$ /confidentialite.php [R=301,L]
  RewriteRule ^en/index\.html$ /en/ [R=301,L]
  RewriteRule ^en/company\.html$ /en/company.php [R=301,L]
  RewriteRule ^en/agri-food\.html$ /en/agri-food.php [R=301,L]
  RewriteRule ^en/construction\.html$ /en/construction.php [R=301,L]
  RewriteRule ^en/mining\.html$ /en/mining.php [R=301,L]
  RewriteRule ^en/catalog\.html$ /en/catalog.php [R=301,L]
  RewriteRule ^en/projects\.html$ /en/projects.php [R=301,L]
  RewriteRule ^en/contact\.html$ /en/contact.php [R=301,L]
  RewriteRule ^en/legal\.html$ /en/legal.php [R=301,L]
  RewriteRule ^en/privacy\.html$ /en/privacy.php [R=301,L]

  # Anciennes URL de l'ancien site, recuperees dans les archives du web.
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^apropos\.php$ /groupe.php [R=301,L]
  RewriteRule ^agriculture\.php$ /agroalimentaire.php [R=301,L]
  RewriteRule ^agrobusiness\.php$ /agroalimentaire.php [R=301,L]
  RewriteRule ^produits\.php$ /catalogue.php [R=301,L]
  RewriteRule ^construction\.php$ /btp.php [R=301,L]
  RewriteRule ^mine\.php$ /mines.php [R=301,L]
  RewriteRule ^actualites\.php$ / [R=301,L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression du texte. La feuille de styles fait 55 Ko brut et environ 12 Ko
# compressee : c'est le plus gros gain restant sur le chemin critique.
# Les images et les polices sont deja compressees, on ne les repasse pas.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/ld+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  # Les polices ne changent jamais et sont sur le chemin critique.
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>
