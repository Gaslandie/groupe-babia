Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domaine canonique : HTTPS + www, en evitant les chaines de redirection.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.groupebabia\.com$ [NC]
  RewriteRule ^ https://www.groupebabia.com%{REQUEST_URI} [R=301,L,NE]

  # Anciennes URL PHP de l'ancien site.
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^apropos\.php$ /groupe.html [R=301,L]
  RewriteRule ^agriculture\.php$ /agroalimentaire.html [R=301,L]
  RewriteRule ^agrobusiness\.php$ /agroalimentaire.html [R=301,L]
  RewriteRule ^produits\.php$ /catalogue.html [R=301,L]
  RewriteRule ^construction\.php$ /btp.html [R=301,L]
  RewriteRule ^mine\.php$ /mines.html [R=301,L]
  RewriteRule ^contact\.php$ /contact.html [R=301,L]
  RewriteRule ^actualites\.php$ / [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
</IfModule>
